# OpenAI-compatible LLM (vLLM 또는 기타 호환 서버)
VLLM_API_KEY=sk-your-key
VLLM_BASE_URL=https://api.openai.com/v1
VLLM_MODEL=gpt-4o-mini

# RAG retrieval service
RAG_BASE=http://localhost:8080

# Server
PORT=3000

# CORS: local Next.js test UI origin (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3001

# Append-only chat history (Postgres, chat_agent schema)
DATABASE_URL=postgresql://user:password@localhost:5432/chat_agent?schema=chat_agent

# TTL for batch/cron expiry (days); request path does not run GC
CHAT_HISTORY_TTL_DAYS=30
